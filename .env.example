LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=qwen/qwen3.8-27b
MIN_SCORE=0.60
# optional: Claude answers when Groq is rate-limited (daily cap protects the credit)
ANTHROPIC_API_KEY=
CLAUDE_DAILY_CAP=300
# LLM_PRIMARY=claude   # use Claude for everything, e.g. to eval Haiku 5.5
# login + daily limits (anonymous visitors are counted per IP address)
GOOGLE_CLIENT_ID=
SESSION_SECRET=change-me-long-random
ANON_DAILY_LIMIT=2
USER_DAILY_LIMIT=50
# TRUST_PROXY=1   # set when running behind nginx
SITE_DAILY_LIMIT=1000   # all visitors together per day
